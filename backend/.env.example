DATABASE_URL=sqlite:///./vera.db
# Supabase Postgres (use Session pooler URI on Windows / Railway — IPv4):
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Direct db.* host is often IPv6-only and may fail locally.

SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Include your Vercel domain after deploy, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional email channel (leave blank to keep in-app only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vera@localhost

# Optional SMS channel (demo/stub provider)
SMS_ENABLED=false
SMS_PROVIDER_URL=
SMS_API_KEY=

# Gemini assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
