# Copy to deploy/.env and fill in before running docker compose.
# PUBLIC_URL must match how users open the site in a browser (no trailing slash).

PUBLIC_URL=http://YOUR_VM_PUBLIC_IP

# PostgreSQL (used by the db container)
POSTGRES_USER=vera
POSTGRES_PASSWORD=change-this-strong-db-password
POSTGRES_DB=vera

# Backend
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional notifications (leave blank to keep in-app only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vera@yourdomain.com
SMS_ENABLED=false
SMS_PROVIDER_URL=
SMS_API_KEY=

# Gemini assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
