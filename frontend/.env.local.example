NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — only needed if you use Supabase client helpers / middleware session refresh.
# VERA login still uses FastAPI JWT. Get these from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key
